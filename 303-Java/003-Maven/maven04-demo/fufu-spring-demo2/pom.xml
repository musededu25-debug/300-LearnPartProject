<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        父工程：继承 maven04-demo 的 groupId / version 和 properties。
        子模块里不用重复写 groupId 和 version，这就是"继承"的作用。
    -->
    <parent>
        <groupId>com.fufu</groupId>
        <artifactId>maven04-demo</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fufu-spring-demo2</artifactId>

    <properties>
        <!-- 编译和运行都用 Java 21 -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- 源码用 UTF-8 编码，避免中文注释乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!--
            Spring 核心依赖：IoC 容器 + 依赖注入都在这里。
            只需要这一个就够用了 —— ApplicationContext、ClassPathXmlApplicationContext
            这些类都由 spring-context 提供。

            它还会自动带进来几个传递依赖（不用你手动写）：
              spring-core、spring-beans、spring-aop、spring-expression
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>7.1.0-M1</version>
        </dependency>

        <!--
            单元测试框架 JUnit 4。
            <scope>test</scope> 表示这个依赖只在【编译和运行测试代码】时可见，
            打出来的 jar 包里不会包含它 —— 生产代码不该依赖测试框架。
        -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
